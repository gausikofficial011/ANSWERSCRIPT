# =============================================================================
# Backend — Development Dockerfile
# Hot-reload enabled via uvicorn --reload
# =============================================================================

FROM python:3.11-slim

# System dependencies for OpenCV, EasyOCR, pdf2image, and WeasyPrint
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV dependencies
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    # pdf2image / poppler
    poppler-utils \
    # WeasyPrint dependencies
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    shared-mime-info \
    # Utilities
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies first (layer caching)
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dev.txt

# Copy source code (volume mount will override in dev)
COPY . .

# Create upload and log directories
RUN mkdir -p uploads/answer_sheets uploads/processed_images \
    uploads/ocr_results uploads/temporary uploads/reports \
    logs/app logs/access logs/error \
    model_cache

# Expose port
EXPOSE 8000

# Development: hot-reload enabled
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "info"]
