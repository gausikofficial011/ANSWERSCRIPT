# =============================================================================
# AI Answer Evaluation System — Root Environment Template
# Copy this file to .env and fill in your values
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Answer Evaluation System"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# ── Backend API ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ai_eval_db
POSTGRES_USER=ai_eval_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_secure_random_256bit_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Password Security ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# ── OCR Configuration ─────────────────────────────────────────────────────────
OCR_ENGINE=easyocr
OCR_DEFAULT_LANGUAGES=en
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_GPU_ENABLED=false

# ── AI Evaluation ─────────────────────────────────────────────────────────────
AI_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
AI_SEMANTIC_WEIGHT=0.6
AI_KEYWORD_WEIGHT=0.4
AI_MODEL_CACHE_DIR=./model_cache

# ── Plagiarism Detection ──────────────────────────────────────────────────────
PLAGIARISM_DEFAULT_THRESHOLD=0.85
PLAGIARISM_SUSPICIOUS_THRESHOLD=0.60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ── Redis (future async queue) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="AI Answer Evaluation System"

# ── Email / Notifications (future) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_EMAIL_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=1000
RATE_LIMIT_API_WINDOW_SECONDS=60
